# ============================================
# ShortLink 环境变量配置模板
# 复制为 .env 并填入真实值后启动
# ============================================

# ---- 数据库 ----
SHORTLINK_DB_USERNAME=root
SHORTLINK_DB_PASSWORD=root

# ---- ShardingSphere AES 列加密密钥 ----
# 生产环境请生成随机密钥（16+ 字符）
SHORTLINK_AES_SECRET_KEY=d6oadClrrb9A3GWo

# ---- 高德地图 API Key (IP 地理位置解析) ----
SHORTLINK_AMAP_KEY=99b616b8433a465891a505ab161746af

# ---- Redis (可选) ----
# SPRING_DATA_REDIS_HOST=127.0.0.1

# ---- RocketMQ (可选) ----
# ROCKETMQ_NAME_SERVER=127.0.0.1:9876

# ---- ClickHouse (可选) ----
# CLICKHOUSE_HOST=127.0.0.1
# CLICKHOUSE_USER=admin
# CLICKHOUSE_PASSWORD=admin

# ---- 短链接域名 (可选, 默认 127.0.0.1:8001) ----
# DOMAIN=127.0.0.1:8001

# ---- 数据库环境 (dev / prod) ----
# database.env=dev
